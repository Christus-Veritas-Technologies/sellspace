# ─── Database ────────────────────────────────────────────────────────────────
# Local SQLite (development)
DATABASE_URL="file:./dev.db"
# Turso/LibSQL (production)
# DATABASE_URL="libsql://<your-db>.turso.io?authToken=<token>"

# ─── Server ───────────────────────────────────────────────────────────────────
CORS_ORIGIN="*"
NODE_ENV="development"

# ─── SMTP (Nodemailer) ────────────────────────────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="noreply@sellspace.co.zw"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-secure-random-32-char-secret"
JWT_REFRESH_SECRET="change-me-to-a-different-secure-random-32-char-secret"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Get these from Google Cloud Console: https://console.cloud.google.com/
# Authorized Redirect URIs (in Google Console):
#   - http://localhost:9999/api/auth/callback/google (local server)
#   - http://localhost:9998/api/auth/callback/google (local web)
#   - https://api.sellspace.co.zw/api/auth/callback/google (prod API)
#   - https://sellspace.co.zw/api/auth/callback/google (prod web)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Web (Next.js public vars) ────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL="http://localhost:9999"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ─── Native (Expo public vars) ────────────────────────────────────────────────
EXPO_PUBLIC_SERVER_URL="http://localhost:9999"
