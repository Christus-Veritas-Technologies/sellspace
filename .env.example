# ─── Database ────────────────────────────────────────────────────────────────
# Local SQLite (development)
DATABASE_URL="file:./dev.db"
# Turso/LibSQL (production)
# DATABASE_URL="libsql://<your-db>.turso.io?authToken=<token>"

# ─── Server ───────────────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:9998"
NODE_ENV="development"

# ─── SMTP (Nodemailer) ────────────────────────────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="noreply@sellspace.co.zw"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-secure-random-32-char-secret"
JWT_REFRESH_SECRET="change-me-to-a-different-secure-random-32-char-secret"

# ─── Web (Next.js public vars) ────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL="http://localhost:9999"

# ─── Native (Expo public vars) ────────────────────────────────────────────────
EXPO_PUBLIC_SERVER_URL="http://localhost:9999"
