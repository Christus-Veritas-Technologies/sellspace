generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
  runtime      = "bun"
}

datasource db {
  provider = "sqlite"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Condition {
  BRAND_NEW
  LIKE_NEW
  GOOD
  FAIR
  FOR_PARTS
}

enum Category {
  ELECTRONICS
  PHONES_TABLETS
  VEHICLES
  FURNITURE
  CLOTHING
  SPORTS_OUTDOORS
  HOME_GARDEN
  BOOKS_EDUCATION
  FOOD_BEVERAGES
  SERVICES
  OTHER
}

enum OfferStatus {
  PENDING
  COUNTERED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum OfferMessageType {
  OFFER
  COUNTER
  ACCEPT
  DECLINE
}

enum NotificationType {
  OFFER_UPDATE
  NEW_MESSAGE
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String
  avatarUrl   String?
  city        String?
  googleId    String?  @unique // Google OAuth identifier
  createdAt   DateTime @default(now())

  listings        Listing[]
  savedListings   SavedListing[]
  notifications   Notification[]
  otpRequests     OtpRequest[]
  reports         Report[]
  givenReviews    Review[]        @relation("GivenReviews")
  receivedReviews Review[]        @relation("ReceivedReviews")

  buyerOfferThreads  OfferThread[]   @relation("BuyerOfferThreads")
  sellerOfferThreads OfferThread[]   @relation("SellerOfferThreads")
  offerMessages      OfferMessage[]

  buyerMessageThreads  MessageThread[] @relation("BuyerMessageThreads")
  sellerMessageThreads MessageThread[] @relation("SellerMessageThreads")
  messages             Message[]

  @@index([email])
  @@index([createdAt])
}

model Listing {
  id          String    @id @default(cuid())
  title       String
  description String
  price       Int       // stored in cents
  condition   Condition
  category    Category
  city        String?
  sold        Boolean   @default(false)
  views       Int       @default(0)
  createdAt   DateTime  @default(now())

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  images         ListingImage[]
  savedBy        SavedListing[]
  offerThreads   OfferThread[]
  messageThreads MessageThread[]
  reports        Report[]
  reviews        Review[]

  @@index([sellerId])
  @@index([category])
  @@index([condition])
  @@index([createdAt])
  @@index([sold])
  @@index([price])
}

model ListingImage {
  id        String @id @default(cuid())
  url       String
  order     Int    @default(0)

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model OfferThread {
  id         String      @id @default(cuid())
  status     OfferStatus @default(PENDING)
  roundCount Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  buyerId String
  buyer   User   @relation("BuyerOfferThreads", fields: [buyerId], references: [id], onDelete: Cascade)

  sellerId String
  seller   User   @relation("SellerOfferThreads", fields: [sellerId], references: [id], onDelete: Cascade)

  messages OfferMessage[]

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model OfferMessage {
  id        String           @id @default(cuid())
  amount    Int              // in cents
  type      OfferMessageType
  createdAt DateTime         @default(now())

  threadId String
  thread   OfferThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([senderId])
}

model MessageThread {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  buyerId String
  buyer   User   @relation("BuyerMessageThreads", fields: [buyerId], references: [id], onDelete: Cascade)

  sellerId String
  seller   User   @relation("SellerMessageThreads", fields: [sellerId], references: [id], onDelete: Cascade)

  messages Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id        String    @id @default(cuid())
  body      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([senderId])
  @@index([createdAt])
}

model SavedListing {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  payload   String           // JSON string
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model OtpRequest {
  id        String   @id @default(cuid())
  email     String
  otpHash   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([createdAt])
}

model Report {
  id        String   @id @default(cuid())
  reason    String
  createdAt DateTime @default(now())

  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([reporterId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1–5
  comment   String?
  createdAt DateTime @default(now())

  reviewerId String
  reviewer   User   @relation("GivenReviews", fields: [reviewerId], references: [id], onDelete: Cascade)

  sellerId String
  seller   User   @relation("ReceivedReviews", fields: [sellerId], references: [id], onDelete: Cascade)

  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@unique([reviewerId, sellerId])
  @@index([sellerId])
  @@index([reviewerId])
  @@index([createdAt])
}
