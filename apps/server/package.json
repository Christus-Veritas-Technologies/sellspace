{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.605.0",
    "@sellspace/db": "workspace:*",
    "@sellspace/env": "workspace:*",
    "dotenv": "catalog:",
    "expo-server-sdk": "^3.14.0",
    "google-auth-library": "^10.6.2",
    "hono": "^4.8.2",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sellspace/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/web-push": "^3.6.4",
    "tsdown": "^0.21.9",
    "typescript": "^6"
  }
}
